{
  "name": "obiad-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Svelte food substitution client with local portion editing, image-ready result cards, and incremental equal-calorie substitutes.",
  "scripts": {
    "generate:api": "openapi-ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "bun ./tools/prepare-meal-images.ts && svelte-check --tsconfig ./tsconfig.json",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "bun ./e2e/launcher.ts",
    "test:performance": "bun ./e2e/launcher.ts performance"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@tanstack/svelte-query": "6.1.38"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@happy-dom/global-registrator": "20.11.6",
    "@hey-api/openapi-ts": "0.99.0",
    "@oxlint/plugins": "1.80.0",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/svelte": "5.4.2",
    "@types/bun": "1.3.14",
    "happy-dom": "20.11.6",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.9",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "8.2.1"
  }
}
